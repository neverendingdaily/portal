<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTMLファビコン挿入ツール</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text x=%2250%%22 y=%2250%%22 style=%22dominant-baseline:central;text-anchor:middle;font-size:90px;%22>🌐</text></svg>">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f7f9fc;
            color: #333;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        h2 { margin-top: 0; color: #2c3e50; }
        .form-group {
            margin-bottom: 20px;
            padding: 15px;
            background: #f1f4f8;
            border-radius: 6px;
        }
        label { font-weight: bold; display: block; margin-bottom: 10px; }
        input[type="file"] { width: 100%; }
        button {
            background-color: #3498db;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
        }
        button:hover { background-color: #2980b9; }
        textarea {
            width: 100%;
            height: 200px;
            margin-top: 20px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            resize: vertical;
        }
        .download-btn {
            display: none;
            background-color: #2ecc71;
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 4px;
            margin-top: 15px;
            font-weight: bold;
        }
        .download-btn:hover { background-color: #27ae60; }
    </style>
</head>
<body>

<div class="container">
    <h2>HTMLファビコン挿入ツール</h2>
    <p>アップロードした画像を文字列（Base64）に変換し、HTMLの<code>&lt;title&gt;</code>直下に埋め込みます。</p>

    <div class="form-group">
        <label>1. 対象のHTMLファイルを選択:</label>
        <input type="file" id="htmlInput" accept=".html, .htm">
    </div>

    <div class="form-group">
        <label>2. ファビコンにする画像を選択 (PNG, JPG, ICO, SVGなど):</label>
        <input type="file" id="imgInput" accept="image/*">
    </div>

    <button onclick="processFiles()">コードを挿入して作成</button>

    <textarea id="outputArea" readonly placeholder="ここに処理されたHTMLコードが表示されます"></textarea>
    <a id="downloadLink" class="download-btn">完成したHTMLをダウンロード</a>
</div>

<script>
    function processFiles() {
        const htmlFile = document.getElementById('htmlInput').files[0];
        const imgFile = document.getElementById('imgInput').files[0];

        if (!htmlFile || !imgFile) {
            alert("HTMLファイルと画像ファイルの両方を選択してください。");
            return;
        }

        // 1. 画像ファイルをData URI (Base64) として読み込む
        const imgReader = new FileReader();
        imgReader.onload = function(e) {
            const imageDataUri = e.target.result;

            // 2. HTMLファイルをテキストとして読み込む
            const htmlReader = new FileReader();
            htmlReader.onload = function(e2) {
                let htmlText = e2.target.result;
                
                // 挿入するファビコンタグ（インデント付き）
                const faviconTag = `\n    <link rel="icon" href="${imageDataUri}">`;

                // <title>タグの閉じタグ（</title>）を探して直下に挿入
                // 大文字小文字（</TITLE>など）にも対応するため正規表現を使用
                if (htmlText.match(/<\/title>/i)) {
                    htmlText = htmlText.replace(/(<\/title>)/i, `$1${faviconTag}`);
                } else if (htmlText.match(/<head>/i)) {
                    // titleタグが無い場合はheadタグの直下に挿入
                    htmlText = htmlText.replace(/(<head>)/i, `$1${faviconTag}`);
                } else {
                    alert("HTML内に <title> または <head> タグが見つかりませんでした。");
                    return;
                }

                // テキストエリアに結果を表示
                document.getElementById('outputArea').value = htmlText;

                // ダウンロードリンクを生成
                const blob = new Blob([htmlText], { type: 'text/html' });
                const url = URL.createObjectURL(blob);
                const downloadLink = document.getElementById('downloadLink');
                
                // 元のファイル名に「_with_favicon」を付けて保存できるようにする
                const newFileName = htmlFile.name.replace(/\.html?$/i, '') + "_with_favicon.html";
                downloadLink.href = url;
                downloadLink.download = newFileName;
                downloadLink.style.display = "block";
            };
            htmlReader.readAsText(htmlFile);
        };
        imgReader.readAsDataURL(imgFile);
    }
</script>

</body>
</html>
